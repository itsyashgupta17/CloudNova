# CloudNova Backend Environment Variables

# MongoDB Connection String (Atlas URI or local MongoDB)
# Examples:
# MongoDB Atlas: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Local MongoDB: MONGODB_URI=mongodb://localhost:27017/cloudnova
MONGODB_URI=

# Optional: Default MongoDB Database Name
MONGODB_DATABASE_NAME=cloudnova

# CloudNova Secret Key (HS256)
CLOUDNOVA_SECRET_KEY=
